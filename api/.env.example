# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---
# Use sqlite+aiosqlite for local dev, postgresql+asyncpg for production
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379/0

# --- Replicate ---
REPLICATE_API_TOKEN=
USE_REPLICATE=true

# Models (override to pin specific versions)
REPLICATE_BG_REMOVER=851-labs/background-remover:a029dff38972b5fda4ec5d75d7d1cd25aeff621d2cf4946a41055d7db66b80bc
REPLICATE_RELIGHT=zsxkib/ic-light:0c184710f902c2dd4593e1aa5e93fcd8f937c2e3d96d0e9ea0f22a87e3f0e7d3
REPLICATE_UPSCALER=nightmareai/real-esrgan:f121d640bd286e1fdc67f9799164c1d5be36ff74576ee11c803ae5b665dd46aa
REPLICATE_PLATE_DETECTOR=

# --- Picsart ---
# Used for background removal. Get a key at https://console.picsart.io/
PICSART_API_KEY=

# Segmentation provider selection: auto | picsart | replicate | none
# 'auto' picks Picsart if the key is set, otherwise Replicate.
SEGMENTATION_PROVIDER=auto

# --- Storage ---
# local | s3
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Required only when STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- API auth ---
# Comma-separated list of API keys. Empty disables auth (dev only).
API_KEYS=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Pipeline tuning ---
MAX_INPUT_PIXELS=24000000
WORKING_MAX_DIM=2048
OUTPUT_MAX_DIM=3840
JPEG_QUALITY=92
JOB_TIMEOUT_SECONDS=300

# --- Pre-segmentation prep (denoise + auto WB + highlight recovery) ---
ENABLE_PREP=true
PREP_DENOISE=true
PREP_WHITE_BALANCE=true
PREP_HIGHLIGHT_RECOVER=true
PREP_WB_STRENGTH=0.6

# Skip segment/compose/shadow when the input already looks like a studio shot
ENABLE_STUDIO_SHORTCIRCUIT=true

# --- Reflection stage (deterministic floor reflection under the car) ---
ENABLE_REFLECTION=true
REFLECTION_OPACITY=0.18
REFLECTION_BLUR=10
# How strongly to bias the reflection toward the local floor colour
# (0=keep car colour, 1=floor colour). 0.5..0.7 reads as a real reflection.
REFLECTION_FLOOR_TINT=0.55

# --- Chassis ambient occlusion (soft darkening under the car) ---
ENABLE_CHASSIS_AO=true
CHASSIS_AO_STRENGTH=0.45

# --- Quality guard (catches AI-introduced duplicate cars) ---
ENABLE_DUPLICATE_GUARD=true

# --- preserve_car blending ---
# 1.0 = original cutout pixel-perfect (no AI lighting on car body)
# 0.92 = 92% original car pixels, 8% AI lighting blend (default)
# Clamped to >= 0.5 for safety.
CAR_IDENTITY_STRENGTH=0.92

# When true, preserve_car uses an adaptive identity strength that lets
# more of Qwen's harmonized lighting through on chrome / glass while
# keeping plates, badges and paint at full identity.
PRESERVE_CAR_ADAPTIVE=true
